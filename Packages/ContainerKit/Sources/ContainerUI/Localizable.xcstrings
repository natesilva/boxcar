{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "Log window title. The first value is the container name. The second value is the Docker context.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Toolbar button that removes all log lines from the window."
    },
    "Copy All" : {
      "comment" : "Toolbar button that copies all log lines."
    },
    "Failed" : {
      "comment" : "Accessibility label of the status light of a container that is dead, in a restart loop, or out of memory."
    },
    "Failed: %lld" : {
      "comment" : "Accessibility label of a Compose project's status. The value is the number of containers that are dead, in a restart loop, or out of memory."
    },
    "Loading…" : {
      "comment" : "Shown in the menu until the container list has loaded."
    },
    "Log stream resumed" : {
      "comment" : "Line in the log window that separates the lines before a restart of the log stream from the lines after it."
    },
    "Logs" : {
      "comment" : "Name of the container log window group."
    },
    "Needs attention" : {
      "comment" : "Accessibility label of the status light of a container that is unhealthy, paused, or exited with an error."
    },
    "Needs attention: %lld" : {
      "comment" : "Accessibility label of a Compose project's status. The value is the number of containers that are unhealthy, paused, or exited with an error."
    },
    "No containers" : {
      "comment" : "Shown under a Docker context that has no containers."
    },
    "Reconnect" : {
      "comment" : "Button that restarts the log stream."
    },
    "Refresh" : {
      "comment" : "Menu item that reloads the container list."
    },
    "Restart" : {
      "comment" : "Menu item that restarts a container."
    },
    "Restart All" : {
      "comment" : "Menu item that restarts all containers of a Compose project."
    },
    "Running" : {
      "comment" : "Accessibility label of the status light of a container that runs normally."
    },
    "Running: %lld" : {
      "comment" : "Accessibility label of a Compose project's status. The value is the number of containers that run normally."
    },
    "Start" : {
      "comment" : "Menu item that starts a container."
    },
    "Start All" : {
      "comment" : "Menu item that starts all containers of a Compose project."
    },
    "Stop" : {
      "comment" : "Menu item that stops a container."
    },
    "Stop All" : {
      "comment" : "Menu item that stops all containers of a Compose project."
    },
    "Stopped" : {
      "comment" : "Accessibility label of the status light of a container that is stopped."
    },
    "Stopped: %lld" : {
      "comment" : "Accessibility label of a Compose project's status. The value is the number of stopped containers."
    },
    "The log stream ended." : {
      "comment" : "Shown at the bottom of the log window when the log stream stops."
    },
    "View Logs…" : {
      "comment" : "Menu item that opens the log window of a container."
    }
  },
  "version" : "1.0"
}