{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (%@)" : {
      "comment" : "Log window title. The first value is the container name. The second value is the Docker context.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$@)"
          }
        }
      }
    },
    "%@ (%lld/%lld running)" : {
      "comment" : "Menu item for a Compose project. The values are the project name, the number of running containers, and the total number of containers.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ (%2$lld/%3$lld running)"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Toolbar button that removes all log lines from the window."
    },
    "Copy All" : {
      "comment" : "Toolbar button that copies all log lines."
    },
    "Loading…" : {
      "comment" : "Shown in the menu until the container list has loaded."
    },
    "Logs" : {
      "comment" : "Name of the container log window group."
    },
    "No containers" : {
      "comment" : "Shown under a Docker context that has no containers."
    },
    "Reconnect" : {
      "comment" : "Button that restarts the log stream."
    },
    "Refresh" : {
      "comment" : "Menu item that reloads the container list."
    },
    "Restart" : {
      "comment" : "Menu item that restarts a container."
    },
    "Restart All" : {
      "comment" : "Menu item that restarts all containers of a Compose project."
    },
    "Start" : {
      "comment" : "Menu item that starts a container."
    },
    "Start All" : {
      "comment" : "Menu item that starts all containers of a Compose project."
    },
    "Stop" : {
      "comment" : "Menu item that stops a container."
    },
    "Stop All" : {
      "comment" : "Menu item that stops all containers of a Compose project."
    },
    "The log stream ended." : {
      "comment" : "Shown at the bottom of the log window when the log stream stops."
    },
    "View Logs…" : {
      "comment" : "Menu item that opens the log window of a container."
    }
  },
  "version" : "1.0"
}