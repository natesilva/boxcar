{
  "sourceLanguage" : "en",
  "strings" : {
    "A line of output is too long to read." : {
      "comment" : "Error shown when the app stops reading the output of a docker command, such as a container log, because one line is too long."
    },
    "Not running" : {
      "comment" : "Error shown under a Docker context whose engine does not accept connections, for example because its app was quit."
    },
    "The command did not respond in time." : {
      "comment" : "Error shown when a docker command takes too long."
    },
    "The command failed with status %@." : {
      "comment" : "Error shown when a docker command fails without an error message. The value is the exit status."
    },
    "The docker CLI was not found." : {
      "comment" : "Error shown when the app cannot find the docker executable."
    }
  },
  "version" : "1.0"
}